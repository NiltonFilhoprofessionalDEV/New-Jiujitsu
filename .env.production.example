# Copie para .env.production (fora do git) e preencha. Nunca reutilize os valores de desenvolvimento.

# Domínio público (o DNS precisa apontar para o servidor) e e-mail para o Let's Encrypt
APP_DOMAIN=app.suaacademia.com.br
ACME_EMAIL=
# Outros endereços que redirecionam para APP_DOMAIN (DNS também apontando para o servidor), ex.: www.suaacademia.com.br
APP_EXTRA_DOMAINS=

# Senha do Postgres. Gere com: openssl rand -base64 32
DATABASE_PASSWORD=

# Pelo menos 32 bytes aleatórios em base64. Gere com: openssl rand -base64 48
# Trocar este valor encerra todas as sessões abertas.
APP_JWT_SECRET=

# Painel /admin da plataforma (e-mails separados por vírgula)
APP_PLATFORM_ADMIN_EMAILS=

# Asaas (produção). Sem chave, o pagamento online fica desligado.
APP_ASAAS_BASE_URL=https://api.asaas.com/v3
# A chave começa com $; use aspas simples para o Docker Compose não tratá-la como variável: APP_ASAAS_API_KEY='$aact_prod_...'
APP_ASAAS_API_KEY=
# 32 a 255 caracteres, igual ao do webhook no painel do Asaas. Gere com: openssl rand -hex 32
APP_ASAAS_WEBHOOK_TOKEN=

# Opcionais
APP_TIME_ZONE=America/Sao_Paulo
APP_RATE_LIMIT_PER_MINUTE=600
BACKUP_KEEP_DAYS=14
# Pasta do servidor onde os dumps ficam; sincronize-a com um armazenamento externo
BACKUP_DIR=./backups
# Opções da JVM. Sem valor, o Java usa até 75% da RAM. Em servidor de 1 GB, use:
# API_JAVA_OPTS=-Xmx256m -XX:MaxMetaspaceSize=160m -Xss512k -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError
