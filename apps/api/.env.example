# Copie para apps/api/.env (nunca versione o .env)
DATABASE_URL=jdbc:postgresql://localhost:5433/academia
DATABASE_USERNAME=academia
DATABASE_PASSWORD=
# Pelo menos 32 bytes aleatórios em base64. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
APP_JWT_SECRET=
# false apenas em desenvolvimento local (http)
APP_COOKIE_SECURE=false
# Origens permitidas separadas por vírgula (produção)
APP_CORS_ALLOWED_ORIGINS=
# E-mails (separados por vírgula) com acesso ao painel /admin da plataforma
APP_PLATFORM_ADMIN_EMAILS=
# Asaas: sandbox em desenvolvimento. A chave precisa ser do mesmo ambiente da URL.
# Sem chave, o pagamento online fica desligado.
APP_ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
APP_ASAAS_API_KEY=
# 32 a 255 caracteres; o mesmo valor cadastrado no webhook do painel do Asaas. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ASAAS_WEBHOOK_TOKEN=
